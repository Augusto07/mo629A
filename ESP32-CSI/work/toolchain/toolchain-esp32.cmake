include($ENV{IDF_PATH}/tools/cmake/toolchain-esp32.cmake)
file(TO_CMAKE_PATH "$ENV{CSI_TOOLCHAIN_BIN}" CSI_TOOLCHAIN_BIN)
set(CMAKE_C_COMPILER "${CSI_TOOLCHAIN_BIN}/xtensa-esp-elf-gcc.exe")
set(CMAKE_CXX_COMPILER "${CSI_TOOLCHAIN_BIN}/xtensa-esp-elf-g++.exe")
set(CMAKE_ASM_COMPILER "${CSI_TOOLCHAIN_BIN}/xtensa-esp-elf-gcc.exe")
set(_CMAKE_TOOLCHAIN_PREFIX xtensa-esp-elf-)
foreach(LANG C CXX ASM)
    if(NOT CMAKE_${LANG}_FLAGS MATCHES "mdynconfig")
        set(CMAKE_${LANG}_FLAGS "${CMAKE_${LANG}_FLAGS} -mdynconfig=xtensa_esp32.so" CACHE STRING "ESP32 flags" FORCE)
    endif()
endforeach()
